<!doctype html>
<!-- Local kiosk status page: lives on the device (file://) so it never
     disappears when the Svenager server is down. Probes the server and
     general internet reachability independently. -->
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Svenager</title>
<style>
  body { margin: 0; min-height: 100vh; display: flex; flex-direction: column;
         align-items: center; justify-content: center; gap: 1.5rem;
         background: #16181d; color: #f4f6fb; font-family: system-ui, sans-serif; }
  .logo { font-size: 4rem; font-weight: 700; letter-spacing: 0.35em; }
  h1 { margin: 0; font-size: 2.2rem; font-weight: 500; }
  p { margin: 0; font-size: 1.4rem; color: #9aa4b5; }
  .flags { display: flex; gap: 1rem; }
  .flag { padding: 0.4rem 1.2rem; border-radius: 2rem; font-size: 1.2rem; }
  .flag.ok { background: #1a7f37; }
  .flag.bad { background: #8a2a2a; }
  .flag.unknown { background: #4a5160; }
</style>
</head>
<body>
  <div class="logo">SVENAGER</div>
  <h1 id="hostname">{{ svenager_hostname | default('device') }}</h1>
  <div class="flags">
    <span id="server" class="flag unknown">Svenager server: checking…</span>
    <span id="internet" class="flag unknown">Internet: checking…</span>
  </div>
  <p id="detail">This device is enrolled in Svenager fleet management.</p>
  <script>
    const STATUS_URL = "{{ svenager_server_url | default('') }}/kiosk-demo/{{ svenager_device_id | default('') }}/status"
    const NET_CHECK_URL = "{{ kiosk_connectivity_url }}"

    // Touch the DOM only on real changes — every write repaints on
    // low-power kiosk browsers.
    function set(id, cls, text) {
      const el = document.getElementById(id)
      if (text !== undefined && el.textContent !== text) el.textContent = text
      if (cls !== undefined && el.className !== 'flag ' + cls) el.className = 'flag ' + cls
    }

    async function probeServer() {
      try {
        const res = await fetch(STATUS_URL, { cache: 'no-store' })
        if (!res.ok) return false
        const d = await res.json()
        const name = document.getElementById('hostname')
        if (d.hostname && name.textContent !== d.hostname) name.textContent = d.hostname
        const detail = document.getElementById('detail')
        const text = 'Last contact: ' + d.lastContact
        if (detail.textContent !== text) detail.textContent = text
        return true
      } catch (ignored) {
        return false
      }
    }

    async function probeInternet() {
      try {
        // no-cors: we only care whether the network round-trip succeeds.
        await fetch(NET_CHECK_URL, { mode: 'no-cors', cache: 'no-store' })
        return true
      } catch (ignored) {
        return false
      }
    }

    async function tick() {
      const [serverOk, internetOk] = await Promise.all([probeServer(), probeInternet()])
      set('server', serverOk ? 'ok' : 'bad', 'Svenager server: ' + (serverOk ? 'reachable' : 'unreachable'))
      set('internet', internetOk ? 'ok' : 'bad', 'Internet: ' + (internetOk ? 'reachable' : 'unreachable'))
      if (!serverOk) {
        const detail = document.getElementById('detail')
        const text = internetOk
          ? 'The Svenager server is not responding — the device itself is online.'
          : 'No network connection.'
        if (detail.textContent !== text) detail.textContent = text
      }
    }

    tick()
    setInterval(tick, 15000)
  </script>
</body>
</html>
