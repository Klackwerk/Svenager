# Copy to .env and fill in — see ../docs/quickstart.md.

# Domain the stack serves. Must resolve to this machine; ports 80/443 must
# be reachable so Caddy can obtain the Let's Encrypt certificate.
SVENAGER_DOMAIN=svenager.example.com

# Image tag to run (a release version, see the GitHub releases page).
# Unset = latest release.
#SVENAGER_VERSION=0.9.0

# Password for the svenager PostgreSQL user (pick any strong value; used by
# both the postgres and server containers).
SVENAGER_DB_PASSWORD=

# base64-encoded 32 bytes, e.g.: openssl rand -base64 32
# Encrypts secrets at rest (deploy keys, secret variables). Losing it makes
# them unrecoverable — back it up.
SVENAGER_ENCRYPTION_KEY=

# Optional: fixed initial admin password. Left empty, one is generated and
# logged once at first start (docker compose logs server).
#SVENAGER_ADMIN_PASSWORD=
