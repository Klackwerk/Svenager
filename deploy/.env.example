# Copy to .env next to docker-compose.prod.yml and fill in.

# Public hostname (must resolve to this machine; Caddy fetches the
# certificate via Let's Encrypt).
SVENAGER_DOMAIN=svenager.example.org

# PostgreSQL password for the svenager user.
SVENAGER_DB_PASSWORD=

# base64-encoded 32 random bytes, e.g.:  openssl rand -base64 32
# Encrypts secrets at rest — back this up; without it stored secrets and
# repository deploy keys are unrecoverable.
SVENAGER_ENCRYPTION_KEY=

# Optional: initial admin password. Left empty, a password is generated
# and logged once at first start.
SVENAGER_ADMIN_PASSWORD=
