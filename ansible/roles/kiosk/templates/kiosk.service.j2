[Unit]
Description=Svenager kiosk session ({{ kiosk_compositor }} + cog)
After=systemd-user-sessions.service seatd.service network-online.target
Wants=network-online.target

[Service]
User={{ kiosk_user }}
PAMName=login
TTYPath=/dev/tty7
{% if kiosk_software_rendering %}
# Virtualized GPUs (virtio/virgl) glitch white frames under GL compositing.
Environment=WLR_RENDERER=pixman
Environment=WLR_NO_HARDWARE_CURSORS=1
Environment=LIBGL_ALWAYS_SOFTWARE=1
{% endif %}
{% if kiosk_compositor == 'sway' %}
ExecStart=/usr/bin/sway -c /etc/svenager-kiosk/sway.config
{% else %}
ExecStart=/usr/bin/cage -s -- /usr/local/bin/kiosk-session.sh
{% endif %}
Restart=always
RestartSec=5
# A wedged compositor must not stall restarts.
TimeoutStopSec=10
# PAMName moves session children into a logind scope, outside this unit's
# cgroup — without this sweep an old cog/wayvnc survives restarts, keeps
# port 5900 and the remote view shows a dead session.
ExecStopPost=-/usr/bin/pkill -KILL -u {{ kiosk_user }}

[Install]
WantedBy=graphical.target
